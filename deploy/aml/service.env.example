# Non-secret settings. The API key is loaded via systemd LoadCredential.
AML_HOSTED_HOST=127.0.0.1
AML_HOSTED_PORT=8081
AML_HOSTED_AUTH_MODE=bearer
AML_HOSTED_MAX_BODY_BYTES=33554432
AML_HOSTED_MAX_INFLIGHT=32
AML_HOSTED_MAX_CONNECTIONS=96
AML_HOSTED_RETRY_AFTER_SECONDS=1
AML_HOSTED_READ_TIMEOUT_SECONDS=10
AML_HOSTED_REQUEST_TIMEOUT_SECONDS=60
AML_HOSTED_OPERATION_TIMEOUT_SECONDS=45
