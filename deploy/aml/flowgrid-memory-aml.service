[Unit]
Description=FlowGrid Agent Memory dedicated AML service
After=network.target

[Service]
Type=simple
User=flowgrid-memory-aml
Group=flowgrid-memory-aml
WorkingDirectory=/var/lib/flowgrid-memory-aml
StateDirectory=flowgrid-memory-aml
StateDirectoryMode=0700
LoadCredential=aml-api-key:/etc/flowgrid-memory-aml/aml.key
Environment=AML_HOSTED_KEY_FILE=%d/aml-api-key
Environment=AML_HOSTED_DB_PATH=/var/lib/flowgrid-memory-aml/memory.sqlite3
Environment=AML_HOSTED_REQUIRE_BUILD_IDENTITY=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/flowgrid-memory-aml/service.env
ExecStart=/opt/flowgrid-memory-aml/venv/bin/flowgrid-memory-aml
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/flowgrid-memory-aml
UMask=0077
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
