# Replace memory.example.org and certificate paths before installation.
# Install inside the nginx http context. Service listens on loopback only.
upstream flowgrid_memory_aml {
    server 127.0.0.1:8081;
}

server {
    listen 443 ssl;
    server_name memory.example.org;
    ssl_certificate /etc/letsencrypt/live/memory.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/memory.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/flowgrid-memory-aml-error.log crit;
    client_max_body_size 32m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;

    location = /health {
        limit_except GET { deny all; }
        proxy_pass http://flowgrid_memory_aml;
        proxy_http_version 1.1;
        proxy_set_header Connection close;
        proxy_set_header Host localhost;
        proxy_read_timeout 65s;
        proxy_connect_timeout 3s;
    }

    location ~ ^/(add|search)$ {
        limit_except POST { deny all; }
        proxy_pass http://flowgrid_memory_aml;
        proxy_http_version 1.1;
        proxy_set_header Connection close;
        proxy_set_header Host localhost;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 65s;
        proxy_send_timeout 10s;
        proxy_connect_timeout 3s;
        proxy_next_upstream off;
    }

    location / {
        return 404;
    }
}
