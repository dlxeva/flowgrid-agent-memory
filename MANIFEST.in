include tests/test_aml_hosted.py tests/test_aml_cycle2_rehearsal.py
include deploy/aml/nginx.conf.example deploy/aml/flowgrid-memory-aml.service
include deploy/aml/service.env.example deploy/aml/install-wheel.sh
